---
import Layout from '../layouts/Layout.astro';
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<Layout title="THÉOPHILE DEREUX — Studio | One-Pager Portfolio">
  <!-- Fixed Header -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-neutral-950/90 backdrop-blur-xl border-b border-neutral-800/80 font-mono text-xs">
    <div class="max-w-7xl mx-auto px-8 py-5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
        <a href="#" class="font-bold text-sm tracking-widest uppercase hover:text-emerald-400 transition-colors">
          THÉOPHILE DEREUX // STUDIO
        </a>
      </div>
      
      <nav class="hidden lg:flex items-center gap-8 text-neutral-400 uppercase tracking-widest text-[11px]">
        <a href="#biographie" class="hover:text-white transition-colors">01. Bio</a>
        <a href="#peinture" class="hover:text-white transition-colors">02. Peinture Abs</a>
        <a href="#photographie" class="hover:text-white transition-colors">03. Photographie</a>
        <a href="#objets" class="hover:text-white transition-colors">04. Objets</a>
        <a href="#murales" class="hover:text-white transition-colors">05. Murales</a>
        <a href="#boutique" class="hover:text-white transition-colors text-emerald-400">06. Boutique</a>
        <a href="#contact" class="hover:text-white transition-colors">07. Contact</a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="https://drive.google.com/file/d/1T6AMb2xcGe5ZqwzNdloZfOVOc9EcU8El/view?usp=drive_link" target="_blank" rel="noopener noreferrer" class="px-4 py-2 border border-emerald-500/60 text-emerald-400 hover:bg-emerald-500/10 rounded tracking-widest text-[11px] font-mono transition-all">
          BOOK PDF 2025
        </a>

        <!-- Dark / Light Mode Toggle Button -->
        <button id="theme-toggle-btn" aria-label="Toggle Theme" class="p-2 border border-neutral-700 hover:border-neutral-500 rounded-lg bg-neutral-900 text-neutral-300 hover:text-white transition-all flex items-center gap-1 font-mono text-[11px]">
          <span id="theme-icon">🌙</span>
          <span id="theme-text" class="hidden sm:inline uppercase">DARK</span>
        </button>
      </div>
    </div>
  </header>

  <main class="pt-28 space-y-32 md:space-y-48">
    
    <!-- 01. BIOGRAPHIE & HERO -->
    <section id="biographie" class="min-h-[85vh] flex flex-col justify-center max-w-7xl mx-auto px-8 py-16 scroll-mt-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-8">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-neutral-900 border border-neutral-800 font-mono text-xs text-neutral-400 rounded-full">
            <span class="text-emerald-400">●</span> ARTISTE PLASTICIEN & PHOTOGRAPHE
          </div>

          <h1 class="text-5xl sm:text-7xl lg:text-8xl font-black uppercase tracking-tight font-display text-white leading-none min-h-[140px]">
            <span id="typewriter-first">THÉOPHILE</span><br/>
            <span id="typewriter-last" class="text-transparent bg-clip-text bg-gradient-to-r from-neutral-100 via-neutral-300 to-neutral-600">DEREUX</span>
            <span id="typewriter-cursor" class="text-emerald-400 animate-pulse font-mono font-normal">_</span>
          </h1>

          <p class="text-lg sm:text-xl text-neutral-300 max-w-2xl font-light leading-relaxed">
            Photographe et plasticien, Théophile Dereux explore les passerelles entre matière, trace et perception. 
            Ayant sillonné le monde pour collecter des textures naturelles et urbaines, il nourrit sa recherche d'un dialogue permanent entre observation et abstraction.
          </p>

          <p class="text-sm text-neutral-400 font-light max-w-xl">
            Fondateur de l'association de médiation culturelle <strong class="text-white font-medium">Streetartera</strong> (2020), il y développe un studio de création ambulant au service de projets artistiques et communautaires.
          </p>

          <!-- Interactive Lighting Dial -->
          <div class="p-6 bg-neutral-900/90 border border-neutral-800 rounded-2xl space-y-4 max-w-xl font-mono text-xs">
            <div class="flex items-center justify-between">
              <span class="text-neutral-400 uppercase tracking-widest">🎛 Cadran de Lumière</span>
              <span id="light-val" class="text-emerald-400">Exposition: Neutral (100%)</span>
            </div>

            <div class="flex items-center gap-4">
              <span class="text-[10px] text-neutral-500">AUBE</span>
              <input id="light-slider" type="range" min="0" max="100" value="50" class="w-full accent-emerald-500 cursor-pointer h-1.5 bg-neutral-800 rounded-lg appearance-none" />
              <span class="text-[10px] text-neutral-500">UV / NUIT</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <!-- Hero Marquee Wrapper -->
          <div class="relative rounded-2xl overflow-hidden border border-neutral-800 bg-neutral-900 shadow-2xl group artwork-container cursor-pointer transition-all duration-700" id="hero-img-box" data-src={base + "images/img_01_page_02.jpg"}>
            
            <!-- Marquee Ticker Header -->
            <div id="hero-marquee" class="absolute top-0 left-0 right-0 z-30 bg-emerald-500/90 text-neutral-950 font-mono text-[10px] font-bold uppercase tracking-widest py-1 px-3 overflow-hidden whitespace-nowrap transition-all duration-500 opacity-100">
              <div class="inline-block animate-marquee">
                THÉOPHILE DEREUX // STUDIO WORK 2025 // MATIÈRE & PERCEPTION // STREETARTERA // 
              </div>
            </div>

            <img id="hero-img" src={base + "images/img_01_page_02.jpg"} alt="Théophile Dereux Studio" class="w-full h-[520px] object-cover filter-artwork transition-all duration-700 transform scale-100" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent z-0"></div>
            <div class="absolute bottom-6 left-6 right-6 font-mono text-xs text-neutral-400 flex justify-between items-end z-20">
              <div>
                <span class="text-white font-bold block text-sm">Portrait & Studio</span>
                <span>Streetartera (2020 - 2025)</span>
              </div>
              <span class="text-emerald-400 font-mono">REF_01 [CLICK TO ENLARGE]</span>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- 02. PEINTURE ABSTRAITE -->
    <section id="peinture" class="max-w-7xl mx-auto px-8 py-20 border-t border-neutral-900 scroll-mt-28 space-y-16">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 font-mono">
        <div class="space-y-3 max-w-2xl">
          <span class="text-xs text-emerald-400 uppercase tracking-widest">// 02. PEINTURE ABSTRAITE</span>
          <h2 class="text-4xl md:text-5xl font-black font-display uppercase tracking-tight text-white">Séries Abstraites</h2>
          <p class="text-neutral-400 font-sans text-base font-light leading-relaxed">
            Les séries « Médiumnité & Exploration » et « ABSPRAY » témoignent d'une recherche sur la matière et la gestualité. 
            De la surface analogique à la suggestion numérique, la peinture de Théophile Dereux relie texture et mouvement.
          </p>
        </div>
        <div class="text-xs text-neutral-500 uppercase tracking-wider border-l-2 border-emerald-500/80 pl-4">
          Spray, résine & pigments<br/>Surfaces grand format
        </div>
      </div>

      <!-- Real Artwork Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="group bg-neutral-900 border border-neutral-800 rounded-2xl overflow-hidden p-4 space-y-4 hover:border-neutral-700 transition-all artwork-container cursor-pointer" data-src={base + "images/img_04_page_05.jpg"}>
          <div class="overflow-hidden rounded-xl bg-neutral-950 aspect-[4/3] relative">
            <img src={base + "images/img_04_page_05.jpg"} alt="Peinture Abstraite ABSPRAY" class="w-full h-full object-cover filter-artwork group-hover:scale-105 transition-transform duration-500" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
          </div>
          <div class="flex justify-between items-center font-mono text-xs pt-1">
            <span class="text-white font-bold text-sm">Série ABSPRAY</span>
            <span class="text-emerald-400">2024</span>
          </div>
        </div>

        <div class="group bg-neutral-900 border border-neutral-800 rounded-2xl overflow-hidden p-4 space-y-4 hover:border-neutral-700 transition-all artwork-container cursor-pointer" data-src={base + "images/img_06_page_07.jpg"}>
          <div class="overflow-hidden rounded-xl bg-neutral-950 aspect-[4/3] relative">
            <img src={base + "images/img_06_page_07.jpg"} alt="Peinture Médiumnité" class="w-full h-full object-cover filter-artwork group-hover:scale-105 transition-transform duration-500" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
          </div>
          <div class="flex justify-between items-center font-mono text-xs pt-1">
            <span class="text-white font-bold text-sm">Série Médiumnité</span>
            <span class="text-emerald-400">2024</span>
          </div>
        </div>

        <div class="group bg-neutral-900 border border-neutral-800 rounded-2xl overflow-hidden p-4 space-y-4 hover:border-neutral-700 transition-all artwork-container cursor-pointer" data-src={base + "images/img_08_page_09.jpg"}>
          <div class="overflow-hidden rounded-xl bg-neutral-950 aspect-[4/3] relative">
            <img src={base + "images/img_08_page_09.jpg"} alt="Peinture Exploration" class="w-full h-full object-cover filter-artwork group-hover:scale-105 transition-transform duration-500" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
          </div>
          <div class="flex justify-between items-center font-mono text-xs pt-1">
            <span class="text-white font-bold text-sm">Série Exploration</span>
            <span class="text-emerald-400">2025</span>
          </div>
        </div>
      </div>
    </section>


    <!-- 03. PHOTOGRAPHIE -->
    <section id="photographie" class="max-w-7xl mx-auto px-8 py-20 border-t border-neutral-900 scroll-mt-28 space-y-16">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 font-mono">
        <div class="space-y-3 max-w-2xl">
          <span class="text-xs text-emerald-400 uppercase tracking-widest">// 03. ARCHIVE PHOTOGRAPHIQUE</span>
          <h2 class="text-4xl md:text-5xl font-black font-display uppercase tracking-tight text-white">Textures Décontextualisées</h2>
          <p class="text-neutral-400 font-sans text-base font-light leading-relaxed">
            Depuis 2014, cette série regroupe plus de deux mille photographies explorant la texture naturelle et urbaine. 
            Chaque image devient une abstraction, un fragment de matière où la lumière compose le tableau.
          </p>
        </div>
        <div class="text-xs text-emerald-400 font-bold bg-emerald-950/40 border border-emerald-500/30 px-4 py-2 rounded-lg">
          2000+ CLICHÉS ARCHIVÉS
        </div>
      </div>

      <!-- Real Photo Gallery -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <div class="group bg-neutral-900 border border-neutral-800 rounded-xl overflow-hidden aspect-square p-2 artwork-container cursor-pointer" data-src={base + "images/img_17_page_17.jpg"}>
          <div class="relative w-full h-full rounded-lg overflow-hidden">
            <img src={base + "images/img_17_page_17.jpg"} alt="Texture décontextualisée 1" class="w-full h-full object-cover filter-artwork group-hover:scale-105 transition-transform duration-300" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
          </div>
        </div>
        <div class="group bg-neutral-900 border border-neutral-800 rounded-xl overflow-hidden aspect-square p-2 artwork-container cursor-pointer" data-src={base + "images/img_20_page_20.jpg"}>
          <div class="relative w-full h-full rounded-lg overflow-hidden">
            <img src={base + "images/img_20_page_20.jpg"} alt="Texture décontextualisée 2" class="w-full h-full object-cover filter-artwork group-hover:scale-105 transition-transform duration-300" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
          </div>
        </div>
        <div class="group bg-neutral-900 border border-neutral-800 rounded-xl overflow-hidden aspect-square p-2 artwork-container cursor-pointer" data-src={base + "images/img_25_page_25.jpg"}>
          <div class="relative w-full h-full rounded-lg overflow-hidden">
            <img src={base + "images/img_25_page_25.jpg"} alt="Texture décontextualisée 3" class="w-full h-full object-cover filter-artwork group-hover:scale-105 transition-transform duration-300" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
          </div>
        </div>
        <div class="group bg-neutral-900 border border-neutral-800 rounded-xl overflow-hidden aspect-square p-2 artwork-container cursor-pointer" data-src={base + "images/img_30_page_30.jpg"}>
          <div class="relative w-full h-full rounded-lg overflow-hidden">
            <img src={base + "images/img_30_page_30.jpg"} alt="Texture décontextualisée 4" class="w-full h-full object-cover filter-artwork group-hover:scale-105 transition-transform duration-300" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
          </div>
        </div>
      </div>
    </section>


    <!-- 04. OBETS & RELIEFS -->
    <section id="objets" class="max-w-7xl mx-auto px-8 py-20 border-t border-neutral-900 scroll-mt-28 space-y-16">
      <div class="space-y-3 max-w-2xl font-mono">
        <span class="text-xs text-emerald-400 uppercase tracking-widest">// 04. VOLUMES & SCULPTURES</span>
        <h2 class="text-4xl md:text-5xl font-black font-display uppercase tracking-tight text-white">Objets & Reliefs</h2>
        <p class="text-neutral-400 font-sans text-base font-light leading-relaxed">
          Exploration tridimensionnelle de la matière brutes, moulages urbains et assemblages plastiques.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="group bg-neutral-900 border border-neutral-800 rounded-2xl p-4 space-y-4 artwork-container cursor-pointer" data-src={base + "images/img_13_page_14.jpg"}>
          <div class="aspect-[16/9] overflow-hidden rounded-xl bg-neutral-950 relative">
            <img src={base + "images/img_13_page_14.jpg"} alt="Volume sculpture 1" class="w-full h-full object-cover filter-artwork group-hover:scale-105 transition-transform duration-300" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
          </div>
          <div class="font-mono text-xs flex justify-between items-center pt-2">
            <span class="text-white font-bold">Relief & Empreinte Urbaine</span>
            <span class="text-neutral-500">Résine & Béton</span>
          </div>
        </div>

        <div class="group bg-neutral-900 border border-neutral-800 rounded-2xl p-4 space-y-4 artwork-container cursor-pointer" data-src={base + "images/img_14_page_15.jpg"}>
          <div class="aspect-[16/9] overflow-hidden rounded-xl bg-neutral-950 relative">
            <img src={base + "images/img_14_page_15.jpg"} alt="Volume sculpture 2" class="w-full h-full object-cover filter-artwork group-hover:scale-105 transition-transform duration-300" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
          </div>
          <div class="font-mono text-xs flex justify-between items-center pt-2">
            <span class="text-white font-bold">Assemblage Plastique</span>
            <span class="text-neutral-500">Pigments Synthétiques</span>
          </div>
        </div>
      </div>
    </section>


    <!-- 05. ART MURAL & COMMANDES -->
    <section id="murales" class="max-w-7xl mx-auto px-8 py-20 border-t border-neutral-900 scroll-mt-28 space-y-16">
      <div class="space-y-3 max-w-3xl font-mono">
        <span class="text-xs text-emerald-400 uppercase tracking-widest">// 05. FRESQUES & COMMANDES</span>
        <h2 class="text-4xl md:text-5xl font-black font-display uppercase tracking-tight text-white">Art Mural & In Situ</h2>
        <p class="text-neutral-400 font-sans text-base font-light leading-relaxed">
          Formé auprès d'artistes comme Sino, Markos 93, Serak ou Dodo Ose, Théophile Dereux s'est ancré dans la scène graffiti. 
          Réalisations murales entre Paris, Montréal, La Ciotat et Marseille.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group bg-neutral-900 border border-neutral-800 rounded-2xl p-4 space-y-4 artwork-container cursor-pointer" data-src={base + "images/img_40_page_41.jpg"}>
          <div class="aspect-[4/3] overflow-hidden rounded-xl bg-neutral-950 relative">
            <img src={base + "images/img_40_page_41.jpg"} alt="Art mural Paris" class="w-full h-full object-cover filter-artwork group-hover:scale-105 transition-transform duration-300" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
          </div>
          <div class="font-mono text-xs space-y-1">
            <span class="text-emerald-400 block">PARIS / ÎLE-DE-FRANCE</span>
            <span class="text-white font-bold block text-sm">Fresques & Graffiti</span>
          </div>
        </div>

        <div class="group bg-neutral-900 border border-neutral-800 rounded-2xl p-4 space-y-4 artwork-container cursor-pointer" data-src={base + "images/img_42_page_43.jpg"}>
          <div class="aspect-[4/3] overflow-hidden rounded-xl bg-neutral-950 relative">
            <img src={base + "images/img_42_page_43.jpg"} alt="Art mural Montreal" class="w-full h-full object-cover filter-artwork group-hover:scale-105 transition-transform duration-300" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
          </div>
          <div class="font-mono text-xs space-y-1">
            <span class="text-emerald-400 block">MONTRÉAL (CANADA)</span>
            <span class="text-white font-bold block text-sm">Collaborations Murale</span>
          </div>
        </div>

        <div class="group bg-neutral-900 border border-neutral-800 rounded-2xl p-4 space-y-4 artwork-container cursor-pointer" data-src={base + "images/img_44_page_45.jpg"}>
          <div class="aspect-[4/3] overflow-hidden rounded-xl bg-neutral-950 relative">
            <img src={base + "images/img_44_page_45.jpg"} alt="Art mural Marseille" class="w-full h-full object-cover filter-artwork group-hover:scale-105 transition-transform duration-300" />
            <canvas class="hover-canvas absolute inset-0 pointer-events-none z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></canvas>
          </div>
          <div class="font-mono text-xs space-y-1">
            <span class="text-emerald-400 block">MARSEILLE / LA CIOTAT</span>
            <span class="text-white font-bold block text-sm">Médiation Streetartera</span>
          </div>
        </div>
      </div>
    </section>


    <!-- 06. BOUTIQUE -->
    <section id="boutique" class="max-w-7xl mx-auto px-8 py-20 border-t border-neutral-900 scroll-mt-28">
      <div class="p-10 bg-gradient-to-r from-emerald-950/30 via-neutral-900 to-neutral-950 border border-emerald-500/30 rounded-3xl flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-xl font-mono">
          <span class="text-xs text-emerald-400 uppercase tracking-widest">// 06. STORE & ACQUISITION</span>
          <h3 class="text-3xl font-bold text-white font-display uppercase">Boutique & Éditions Limitées</h3>
          <p class="text-xs text-neutral-400 font-sans leading-relaxed">
            Prints numérotés, tirages photographiques sur papier d'art et pièces originales disponibles sur demande.
          </p>
        </div>
        <a href="mailto:theodereux@gmail.com?subject=Acquisition%20/%20Boutique" class="whitespace-nowrap px-8 py-4 bg-emerald-500 hover:bg-emerald-400 text-neutral-950 font-bold font-mono text-xs uppercase tracking-widest rounded-full transition-all shadow-lg shadow-emerald-500/20">
          Demande d'Acquisition
        </a>
      </div>
    </section>


    <!-- 07. CONTACT -->
    <section id="contact" class="max-w-7xl mx-auto px-8 py-20 border-t border-neutral-900 scroll-mt-28 space-y-12">
      <div class="space-y-4 max-w-2xl font-mono">
        <span class="text-xs text-emerald-400 uppercase tracking-widest">// 07. CONTACT</span>
        <h2 class="text-4xl md:text-5xl font-black font-display uppercase tracking-tight text-white">Théophile Dereux</h2>
        <p class="text-neutral-400 font-sans text-base font-light">
          Pour toute demande d'exposition, acquisition, commande murale ou médiation culturelle.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 font-mono">
        <a href="mailto:theodereux@gmail.com" class="p-6 bg-neutral-900 border border-neutral-800 hover:border-emerald-500/50 rounded-2xl transition-all space-y-2 block">
          <span class="text-[10px] text-neutral-500 uppercase">EMAIL</span>
          <div class="text-sm font-bold text-white truncate">theodereux@gmail.com</div>
        </a>

        <a href="tel:+33749240924" class="p-6 bg-neutral-900 border border-neutral-800 hover:border-emerald-500/50 rounded-2xl transition-all space-y-2 block">
          <span class="text-[10px] text-neutral-500 uppercase">TÉLÉPHONE</span>
          <div class="text-sm font-bold text-white">+33 7 49 24 09 24</div>
        </a>

        <a href="https://instagram.com/streetpsychologist" target="_blank" class="p-6 bg-neutral-900 border border-neutral-800 hover:border-emerald-500/50 rounded-2xl transition-all space-y-2 block">
          <span class="text-[10px] text-neutral-500 uppercase">INSTAGRAM ARTISTE</span>
          <div class="text-sm font-bold text-white">@streetpsychologist</div>
        </a>

        <a href="https://instagram.com/streetartera" target="_blank" class="p-6 bg-neutral-900 border border-neutral-800 hover:border-emerald-500/50 rounded-2xl transition-all space-y-2 block">
          <span class="text-[10px] text-neutral-500 uppercase">ASSOCIATION</span>
          <div class="text-sm font-bold text-white">@streetartera</div>
        </a>
      </div>

      <div class="p-8 bg-neutral-900 border border-neutral-800 rounded-3xl flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-1">
          <h3 class="text-xl font-bold font-display text-white">Book Complete PDF (2025)</h3>
          <p class="text-xs text-neutral-400">Document 50 pages HD avec l'ensemble des œuvres et séries.</p>
        </div>
        <a href="https://drive.google.com/file/d/1T6AMb2xcGe5ZqwzNdloZfOVOc9EcU8El/view?usp=drive_link" target="_blank" rel="noopener noreferrer" class="px-8 py-3.5 bg-white hover:bg-neutral-200 text-neutral-950 font-mono font-bold text-xs uppercase tracking-widest rounded-full transition-all">
          Télécharger PDF
        </a>
      </div>
    </section>

  </main>

  <!-- Interactive Lightbox Modal with Carousel -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 bg-black/95 backdrop-blur-2xl hidden flex-col items-center justify-center p-6 transition-all duration-300 select-none">
    <!-- Top Bar: Counter & Close -->
    <div class="absolute top-6 left-6 right-6 flex items-center justify-between z-50 font-mono text-xs text-neutral-400">
      <div id="lightbox-counter" class="px-4 py-2 bg-neutral-900/90 border border-neutral-800 rounded-full text-emerald-400 font-bold">
        1 / 14
      </div>
      <button id="lightbox-close" class="p-3 bg-neutral-900/90 hover:bg-neutral-800 border border-neutral-800 text-white rounded-full font-mono text-xs uppercase tracking-wider transition-all">
        ✕ CLOSE [ESC]
      </button>
    </div>

    <!-- Carousel Controls -->
    <button id="lightbox-prev" class="absolute left-6 top-1/2 -translate-y-1/2 z-50 p-4 bg-neutral-900/90 hover:bg-neutral-800 border border-neutral-800 text-white rounded-full transition-all hover:scale-110">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>

    <img id="lightbox-img" src="" alt="Full view" class="max-h-[80vh] max-w-[85vw] object-contain rounded-xl border border-neutral-800 shadow-2xl transition-transform duration-300 cursor-pointer" title="Click to close" />

    <button id="lightbox-next" class="absolute right-6 top-1/2 -translate-y-1/2 z-50 p-4 bg-neutral-900/90 hover:bg-neutral-800 border border-neutral-800 text-white rounded-full transition-all hover:scale-110">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>

  <footer class="py-12 border-t border-neutral-900 text-center font-mono text-xs text-neutral-600">
    © 2025 THÉOPHILE DEREUX STUDIO // ONE-PAGER EDITION
  </footer>

  <script>
    // 5-Second Letter-by-Letter Typewriter Effect for "THÉOPHILE DEREUX"
    const firstEl = document.getElementById('typewriter-first');
    const lastEl = document.getElementById('typewriter-last');
    const cursorEl = document.getElementById('typewriter-cursor');

    const firstName = "THÉOPHILE";
    const lastName = "DEREUX";
    const totalChars = firstName.length + lastName.length;
    const intervalTime = 5000 / totalChars; // Exactly 5 seconds total

    if (firstEl && lastEl) {
      firstEl.textContent = "";
      lastEl.textContent = "";

      let charIndex = 0;
      const typeTimer = setInterval(() => {
        if (charIndex < firstName.length) {
          firstEl.textContent += firstName[charIndex];
        } else if (charIndex < totalChars) {
          const lastCharIdx = charIndex - firstName.length;
          lastEl.textContent += lastName[lastCharIdx];
        } else {
          clearInterval(typeTimer);
          if (cursorEl) {
            setTimeout(() => cursorEl.style.display = 'none', 1500);
          }
        }
        charIndex++;
      }, intervalTime);
    }

    // Hero Image 3-Second Marquee Toggle & Scale (0 to 100) Loop
    const heroImg = document.getElementById('hero-img');
    const heroMarquee = document.getElementById('hero-marquee');
    const heroBox = document.getElementById('hero-img-box');

    let heroState = true;
    setInterval(() => {
      heroState = !heroState;

      if (heroState) {
        if (heroMarquee) {
          heroMarquee.style.opacity = '1';
          heroMarquee.style.transform = 'translateY(0)';
        }
        if (heroImg) {
          heroImg.style.transform = 'scale(1)';
          heroImg.style.opacity = '1';
        }
        if (heroBox) {
          heroBox.style.borderColor = 'rgba(16, 185, 129, 0.8)';
        }
      } else {
        if (heroMarquee) {
          heroMarquee.style.opacity = '0';
          heroMarquee.style.transform = 'translateY(-100%)';
        }
        if (heroImg) {
          heroImg.style.transform = 'scale(0)';
          heroImg.style.opacity = '0';
        }
        if (heroBox) {
          heroBox.style.borderColor = 'rgba(38, 38, 38, 1)';
        }

        // Scale up from 0 to 100
        setTimeout(() => {
          if (heroImg) {
            heroImg.style.transform = 'scale(1)';
            heroImg.style.opacity = '1';
          }
        }, 500);
      }
    }, 3000);

    // Theme Switcher (Dark / Light)
    const themeBtn = document.getElementById('theme-toggle-btn');
    const themeIcon = document.getElementById('theme-icon');
    const themeText = document.getElementById('theme-text');

    function updateThemeUI(isDark: boolean) {
      if (themeIcon) themeIcon.textContent = isDark ? '🌙' : '☀️';
      if (themeText) themeText.textContent = isDark ? 'DARK' : 'LIGHT';
    }

    const isDarkInitial = document.documentElement.classList.contains('dark');
    updateThemeUI(isDarkInitial);

    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateThemeUI(isDark);
    });

    // Lighting dial slider script
    const slider = document.getElementById('light-slider') as HTMLInputElement;
    const label = document.getElementById('light-val');
    const artworks = document.querySelectorAll('.filter-artwork');

    slider?.addEventListener('input', (e) => {
      const val = parseInt((e.target as HTMLInputElement).value);
      if (label) {
        if (val < 30) label.textContent = 'Exposition: Aube / Cold (30%)';
        else if (val < 70) label.textContent = 'Exposition: Neutral (100%)';
        else label.textContent = 'Exposition: Night / UV (180%)';
      }

      artworks.forEach((art) => {
        const el = art as HTMLElement;
        el.style.filter = `brightness(${0.6 + val / 100}) contrast(${0.8 + val / 90})`;
      });
    });

    // Interactive Hover Canvas Effect (Bokeh Light Effect on Mouse Over)
    document.querySelectorAll('.artwork-container').forEach((container) => {
      const canvas = container.querySelector('.hover-canvas') as HTMLCanvasElement;
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      let rect = container.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;

      interface BokehParticle {
        x: number;
        y: number;
        radius: number;
        alpha: number;
        vx: number;
        vy: number;
        color: string;
      }

      let particles: BokehParticle[] = [];
      let isHovered = false;
      let animId: number | null = null;

      function createParticles(x: number, y: number) {
        particles = [];
        const colors = [
          'rgba(16, 185, 129,',   // Emerald
          'rgba(52, 211, 153,',   // Light Emerald
          'rgba(245, 158, 11,',   // Warm Amber Bokeh
          'rgba(255, 255, 255,'   // Soft White
        ];

        for (let i = 0; i < 18; i++) {
          particles.push({
            x: x + (Math.random() - 0.5) * 140,
            y: y + (Math.random() - 0.5) * 140,
            radius: Math.random() * 28 + 12,
            alpha: Math.random() * 0.35 + 0.15,
            vx: (Math.random() - 0.5) * 0.8,
            vy: (Math.random() - 0.5) * 0.8 - 0.2,
            color: colors[Math.floor(Math.random() * colors.length)]
          });
        }
      }

      function animate() {
        if (!isHovered && particles.length === 0) {
          ctx?.clearRect(0, 0, canvas.width, canvas.height);
          return;
        }

        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.globalCompositeOperation = 'screen';

        particles.forEach((p, idx) => {
          p.x += p.vx;
          p.y += p.vy;
          p.alpha -= 0.003;

          if (p.alpha <= 0) {
            particles.splice(idx, 1);
            return;
          }

          const grad = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.radius);
          grad.addColorStop(0, `${p.color} ${p.alpha})`);
          grad.addColorStop(0.6, `${p.color} ${p.alpha * 0.4})`);
          grad.addColorStop(1, `${p.color} 0)`);

          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          ctx.fill();
        });

        if (isHovered || particles.length > 0) {
          animId = requestAnimationFrame(animate);
        }
      }

      container.addEventListener('mouseenter', (e) => {
        isHovered = true;
        rect = container.getBoundingClientRect();
        const mouseEvent = e as MouseEvent;
        createParticles(mouseEvent.clientX - rect.left, mouseEvent.clientY - rect.top);
        if (!animId) animate();
      });

      container.addEventListener('mousemove', (e) => {
        rect = container.getBoundingClientRect();
        const mouseEvent = e as MouseEvent;
        const x = mouseEvent.clientX - rect.left;
        const y = mouseEvent.clientY - rect.top;

        if (particles.length < 15 && Math.random() > 0.4) {
          const colors = ['rgba(16, 185, 129,', 'rgba(52, 211, 153,', 'rgba(245, 158, 11,'];
          particles.push({
            x: x + (Math.random() - 0.5) * 80,
            y: y + (Math.random() - 0.5) * 80,
            radius: Math.random() * 24 + 10,
            alpha: Math.random() * 0.3 + 0.15,
            vx: (Math.random() - 0.5) * 0.6,
            vy: (Math.random() - 0.5) * 0.6 - 0.3,
            color: colors[Math.floor(Math.random() * colors.length)]
          });
        }
      });

      container.addEventListener('mouseleave', () => {
        isHovered = false;
      });
    });

    // Lightbox Modal & Carousel logic
    const modal = document.getElementById('lightbox-modal');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const counterEl = document.getElementById('lightbox-counter');

    const artworkCards = Array.from(document.querySelectorAll('.artwork-container'));
    const galleryItems = artworkCards.map((card) => card.getAttribute('data-src')).filter(Boolean) as string[];
    let currentIndex = 0;

    function updateLightbox(index: number) {
      if (galleryItems.length === 0) return;
      currentIndex = (index + galleryItems.length) % galleryItems.length;
      if (modalImg) modalImg.src = galleryItems[currentIndex];
      if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${galleryItems.length}`;
    }

    function openModal(index: number) {
      updateLightbox(index);
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    }

    function closeModal() {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }

    artworkCards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        openModal(idx);
      });
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateLightbox(currentIndex - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateLightbox(currentIndex + 1);
    });

    // Click on enlarged image closes the modal automatically
    modalImg?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeModal();
    });

    closeBtn?.addEventListener('click', closeModal);

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    // Keyboard navigation (ArrowLeft, ArrowRight, Escape)
    document.addEventListener('keydown', (e) => {
      if (modal?.classList.contains('hidden')) return;
      if (e.key === 'ArrowLeft') {
        updateLightbox(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        updateLightbox(currentIndex + 1);
      } else if (e.key === 'Escape') {
        closeModal();
      }
    });
  </script>
</Layout>
