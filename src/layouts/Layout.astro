---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "THÉOPHILE DEREUX — Studio | One-Pager Portfolio", 
  description = "Photographe et plasticien, Théophile Dereux explore les passerelles entre matière, trace et perception." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" class="scroll-smooth dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script is:inline>
      // Initial theme check
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-neutral-950 text-neutral-100 dark:bg-neutral-950 dark:text-neutral-100 light-mode-styles transition-colors duration-300 font-sans antialiased">
    <slot />
  </body>
</html>

<style is:global>
  html:not(.dark) body {
    background-color: #f8fafc;
    color: #0f172a;
  }
  html:not(.dark) header {
    background-color: rgba(255, 255, 255, 0.85);
    border-color: #e2e8f0;
    color: #0f172a;
  }
  html:not(.dark) header a {
    color: #1e293b;
  }
  html:not(.dark) .bg-neutral-900 {
    background-color: #ffffff;
    border-color: #cbd5e1;
    color: #0f172a;
  }
  html:not(.dark) .bg-neutral-950 {
    background-color: #f8fafc;
  }
  html:not(.dark) .text-white {
    color: #0f172a;
  }
  html:not(.dark) .text-neutral-300,
  html:not(.dark) .text-neutral-400 {
    color: #334155;
  }
  html:not(.dark) .border-neutral-800,
  html:not(.dark) .border-neutral-900 {
    border-color: #e2e8f0;
  }
</style>
